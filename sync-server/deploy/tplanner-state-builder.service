[Unit]
Description=tPlanner Sync V3 State Builder (single writer)
After=network.target nats-server.service
Requires=nats-server.service

[Service]
Type=simple
User=tplanner
WorkingDirectory=/opt/tplanner-sync/sync-server
ExecStart=/usr/bin/node /opt/tplanner-sync/sync-server/src/materializer/main.js
Restart=on-failure
RestartSec=5
# 双实例防护的第一道线;最终保证是 SQLite writer lease(见 docs/sync-v3.md §9)
StartLimitIntervalSec=60
StartLimitBurst=5
Environment=TPLANNER_DB_PATH=/var/lib/tplanner-sync/state/tplanner.db

[Install]
WantedBy=multi-user.target
