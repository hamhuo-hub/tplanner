http://plan.hamhuo.top:37400 {
	bind 127.0.0.1
	encode zstd gzip

	@webApi path /tplanner/*
	basicauth @webApi {
		hamhuo __TPLANNER_BASIC_HASH__
	}
	handle_errors {
		@authError expression {err.status_code} == 401
		handle @authError {
			header -WWW-Authenticate
			respond "Unauthorized" 403
		}
	}
	handle @webApi {
		reverse_proxy 127.0.0.1:37401
	}

	handle {
		root * /srv/tplanner-web/current
		try_files {path} /index.html
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		file_server
	}
}
